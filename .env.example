# === SoloHive: настройки LLM ===
# 1) Скопируйте файл:   cp .env.example .env      (Windows: copy .env.example .env)
# 2) Вставьте бесплатный ключ Gemini: https://aistudio.google.com/apikey
# Файл .env в git не попадает (см. .gitignore). Никогда не коммитьте реальные ключи.

GEMINI_API_KEY=your_gemini_api_key_here

# Основная модель и запасные. Если основная перегружена (503), запрос временно уходит на запасную;
# если у проекта нет квоты на модель, она исключается. Фактические модели пишутся в паспорт отчёта.
# Свои бесплатные лимиты по моделям смотрите в AI Studio: https://aistudio.google.com/rate-limit
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite

# --- Необязательные параметры ---
# LLM_PROVIDER=gemini          # gemini | openrouter | openai | anthropic | ollama (по умолчанию — по найденному ключу)
# LLM_TEMPERATURE=0.2
# LLM_CONCURRENCY=3            # сколько запросов к модели выполнять параллельно (для OpenRouter по умолчанию 6)
# LLM_RPM=0                    # ограничение запросов в минуту (0 — без ограничения; ответы 429 обрабатываются)
# REVIEW_BATCH_SIZE=12         # сколько требований проверяет один запрос рецензента (для OpenRouter по умолчанию 8)
# GEMINI_THINKING_LEVEL=       # minimal | low | medium | high (пусто — режим модели по умолчанию)
# LLM_TIMEOUT=240              # тайм-аут одного HTTP-запроса, с
# LLM_MAX_WAIT=150             # максимум ожидания одного ответа с учётом повторов, с

# --- OpenRouter: те же модели Gemini, оплата картой от $5 (https://openrouter.ai/settings/keys) ---
# LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=your_openrouter_api_key_here
# OPENROUTER_MODEL=google/gemini-3.8-flash
# OPENROUTER_FALLBACK_MODELS=google/gemini-3.6-flash

# --- Другие провайдеры (по выбору) ---
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.deepseek.com/v1     # для DeepSeek и др. совместимых API
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# ANTHROPIC_MODEL=claude-sonnet-5-5
# OLLAMA_BASE_URL=http://localhost:11434          # локальные модели
# OLLAMA_MODEL=qwen2.5:14b
