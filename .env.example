# === SoloHive: настройки LLM ===
# 1) Скопируйте файл:   cp .env.example .env      (Windows: copy .env.example .env)
# 2) Вставьте бесплатный ключ Gemini: https://aistudio.google.com/apikey
# Файл .env в git не попадает (см. .gitignore). Никогда не коммитьте реальные ключи.

GEMINI_API_KEY=your_gemini_api_key_here

# Основная модель и запасные: если модель недоступна на вашем тарифе или исчерпана квота,
# агент сам переключится на следующую и запишет это в паспорт отчёта.
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite,gemini-flash-latest

# --- Необязательные параметры ---
# LLM_PROVIDER=gemini          # gemini | openai | anthropic | ollama (по умолчанию — по найденному ключу)
# LLM_TEMPERATURE=0.2
# LLM_CONCURRENCY=4            # сколько запросов к модели выполнять параллельно
# LLM_RPM=0                    # ограничение запросов в минуту (0 — без ограничения; ответы 429 обрабатываются)
# REVIEW_BATCH_SIZE=6          # сколько требований проверяет один запрос рецензента
# GEMINI_THINKING_LEVEL=       # minimal | low | medium | high (пусто — режим модели по умолчанию)
# LLM_TIMEOUT=240              # тайм-аут одного запроса, с

# --- Другие провайдеры (по выбору) ---
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.deepseek.com/v1     # для DeepSeek, OpenRouter и др. совместимых API
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# ANTHROPIC_MODEL=claude-sonnet-5-5
# OLLAMA_BASE_URL=http://localhost:11434          # локальные модели
# OLLAMA_MODEL=qwen2.5:14b
